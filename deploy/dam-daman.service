[Unit]
Description=Dam-Daman game server (room online)
After=network.target

[Service]
Type=simple
User=__DEPLOY_USER__
WorkingDirectory=__SERVER_PATH__
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=HOST=127.0.0.1
ExecStart=__NODE_BIN__ __SERVER_PATH__/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
